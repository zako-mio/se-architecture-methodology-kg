      ],
      "entry_links": [
        "https://www.iso.org/standard/74393.html",
        "https://www.sei.cmu.edu/architecture/"
      ]
    },
    {
      "id": "MTH-G-01",
      "name": "ATAM 架构权衡评估",
      "en": "Architecture Tradeoff Analysis Method",
      "aliases": [
        "ATAM",
        "架构权衡分析"
      ],
      "type": "method",
      "subtype": "process",
      "src": null,
      "group": "GL-METHOD",
      "layer": "methodology",
      "domain": "G",
      "stage": "intermediate",
      "priority": "P1",
      "definition": "从业务驱动与架构出发，细化为场景与支撑它们的架构决策，分析产出风险、非风险、敏感点、权衡点并归纳为风险主题的架构评估方法。",
      "cross_cutting": [
        "M"
      ],
      "case": [],
      "detail": {
        "principle": "以质量属性场景驱动评估，把隐含假设显式化为可讨论的风险，架构不是对错题而是场景下的权衡。",
        "mechanism": "收集场景→映射架构决策→标注 sensitivity/tradeoff points→归纳 risk themes。",
        "engineering": "在里程碑处组织评审，用输出驱动架构迭代与文档更新。",
        "tradeoff": "评估需要干系人时间与领域知识投入；浅评可能遗漏深层权衡点。"
      },
      "sources": [
        "OFF-002",
        "PAP-007"
      ],
