  "nodes": [
    {
      "id": "ESS-G-01",
      "name": "架构即根本性决策",
      "en": "Architecture as Fundamental Decisions",
      "aliases": [
        "架构定义",
        "根本性决策"
      ],
      "type": "principle",
      "subtype": "concept",
      "src": null,
      "group": "GL-ESSENCE",
      "layer": "essence",
      "domain": "G",
      "stage": "advanced",
      "priority": "P0",
      "definition": "架构是系统在环境中的根本性概念或属性，体现于元素、元素间关系及指导其设计与演化的原则，只关心影响全局且对外可见的部分。",
      "cross_cutting": [],
      "case": [
        "CAS-H-01"
      ],
      "detail": {
        "principle": "只有 significant / fundamental 的决策才属于架构；架构只关心元素的 public 侧，内部实现细节不属于架构。",
        "mechanism": "用元素、关系、原则三要素刻画系统；架构向外确定边界，详细设计向内填充实现。",
        "engineering": "以 ADR 记录影响结构、非功能特性、依赖、接口或构造技术的决策。",
        "tradeoff": "过度架构带来前置成本与投机性抽象；架构不足则使质量属性与演化能力失守。"
      },
      "sources": [
        "STD-001",
        "OFF-002"
      ],
      "verified": true,
      "confidence": "high",
      "review_date": "2026-09-10",
      "status": "active",
      "version": null,
      "deprecated_at": null,
      "superseded_by": null,
      "errata": [],
